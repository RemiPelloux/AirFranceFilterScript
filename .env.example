# Copy to .env and adjust. Every variable is optional.
# `make run` loads .env automatically.

AFF_HOST=127.0.0.1
PORT=5555

# Akamai detects headless Chrome: keep false unless you know what you're doing.
AFF_HEADLESS=false
AFF_BROWSER_CHANNEL=chrome
AFF_STARTUP_TIMEOUT=45

# Reload the AF page after this many idle seconds to renew Akamai cookies.
AFF_KEEPALIVE=480

# In-page fetch behaviour
AFF_MAX_RETRIES=3
AFF_RETRY_BACKOFF_MS=800
AFF_BATCH_CONCURRENCY=3
AFF_BATCH_ITEM_DELAY_MS=350
AFF_MAX_BATCH_DATES=31

# Response cache (0 disables it)
AFF_CACHE_TTL=600
AFF_CACHE_MAX=512

AFF_LOG_LEVEL=INFO
